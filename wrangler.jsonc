// Cloudflare Workers: this site is static, so the Worker only serves the built files in dist/.
// With this file present, `npx wrangler deploy` uploads dist/ as-is instead of trying to auto-configure the project.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sainath-khot-portfolio",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
